# Copy to .env next to compose.yaml and adjust. docker compose reads it.

# The host names or IP addresses clients use to reach this server,
# comma-separated. The MCP server rejects requests for any other host
# (protection against DNS rebinding); AnkiConnect does not check it.
ANKI_SERVER_HOSTS=192.0.2.10

# The Anki profile; created on the first start.
ANKI_PROFILE=User 1

# Where the profile (the collection and Anki's own backups) and the add-ons'
# settings live on this host.
ANKI_DATA_DIR=./data

# The addresses the ports are published on: 0.0.0.0 for every interface,
# 127.0.0.1 for this host only.
# AnkiConnect (8765) and the MCP server (3141), plain HTTP. With the tls
# profile set it to 127.0.0.1, so clients can only use HTTPS.
ANKI_BIND=0.0.0.0
# VNC (5900): no password and Anki's whole window. Keep it on 127.0.0.1 and
# use an SSH tunnel: ssh -L 5900:127.0.0.1:5900 <this host>
VNC_BIND=127.0.0.1

# HTTPS (docker compose --profile tls up -d): a name with an A record that
# points at this host, and a Cloudflare API token with Zone DNS Edit and
# Zone Read on its zone (server/set-token.sh writes it). Leave both empty
# without the tls profile.
ANKI_TLS_NAME=
CF_API_TOKEN=
# HTTPS (443) is published on:
TLS_BIND=0.0.0.0
